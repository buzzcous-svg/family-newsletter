# Copy this file to functions/.secret.local (already gitignored) and fill in real values.
# `firebase emulators:start` automatically loads these so the callable functions can run
# locally without touching real secret storage.
#
# In production, set the same names as Firebase secrets instead:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set GUEST_PASSWORD

# Anthropic API key — used by runAIEditor for description drafting and issue generation.
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Shared read-only "site password" for guest access — checked by verifyGuestPassword.
GUEST_PASSWORD=choose-a-guest-site-password
